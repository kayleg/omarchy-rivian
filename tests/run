#!/usr/bin/env bash
# Every assertion here runs the real mapping over a saved gateway answer, so a
# field Rivian renames breaks a test rather than silently blanking the panel.
set -uo pipefail
cd "$(dirname "$0")/.."
RIVIAN=./bin/rivian
pass=0; fail=0

check() { # check NAME EXPECTED ACTUAL
  if [ "$2" = "$3" ]; then pass=$((pass+1))
  else fail=$((fail+1)); printf '  FAIL %s\n    expected: %s\n    actual:   %s\n' "$1" "$2" "$3"; fi
}

read_field() { $RIVIAN --units "$2" render < "tests/fixtures/$1" | jq -c "$3"; }

echo "parked, imperial"
check "range mi"      "179.6"   "$(read_field gateway-parked.json miles .range)"
check "range unit"    '"mi"'    "$(read_field gateway-parked.json miles .range_unit)"
check "odometer mi"   "13349"   "$(read_field gateway-parked.json miles .odometer)"
check "inside °F"     "71"      "$(read_field gateway-parked.json miles .inside_temp)"
check "state"         '"asleep"' "$(read_field gateway-parked.json miles .state)"
check "not driving"   "false"   "$(read_field gateway-parked.json miles .driving)"
check "locked"        "true"    "$(read_field gateway-parked.json miles .locked)"
check "nothing open"  "[]"      "$(read_field gateway-parked.json miles .open)"
check "not plugged"   "false"   "$(read_field gateway-parked.json miles .plugged)"
# jq counts false as absent, so a legitimately-false boolean must survive.
check "brake fluid"   "false"   "$(read_field gateway-parked.json miles .brake_fluid_low)"
check "lat"           "37.7749" "$(read_field gateway-parked.json miles .lat)"

echo "parked, metric"
check "range km"      "289"     "$(read_field gateway-parked.json km .range)"
check "odometer km"   "21483"   "$(read_field gateway-parked.json km .odometer)"
check "inside °C"     "22"      "$(read_field gateway-parked.json km .inside_temp)"

echo "driving"
check "speed mph"     "65"      "$(read_field gateway-driving.json miles .speed)"
check "speed km/h"    "105"     "$(read_field gateway-driving.json km .speed)"
check "driving"       "true"    "$(read_field gateway-driving.json miles .driving)"
check "state online"  '"online"' "$(read_field gateway-driving.json miles .state)"
check "open grouped"  '["a door","the frunk"]' "$(read_field gateway-driving.json miles .open)"
check "one low tyre"  "1"       "$(read_field gateway-driving.json miles .tyres.low)"
check "brake fluid"   "true"    "$(read_field gateway-driving.json miles .brake_fluid_low)"

echo "charging"
check "charging now"  "true"    "$(read_field gateway-charging.json miles .charging_now)"
check "plugged"       "true"    "$(read_field gateway-charging.json miles .plugged)"
check "mins to full"  "47"      "$(read_field gateway-charging.json miles .minutes_to_full)"

echo "sparse: a car the cloud has barely heard from"
check "still ok"      "true"    "$(read_field gateway-sparse.json miles .ok)"
check "state unknown" '"unknown"' "$(read_field gateway-sparse.json miles .state)"
# Unknown must not render as unlocked.
check "locked null"   "null"    "$(read_field gateway-sparse.json miles .locked)"
check "no position"   "null"    "$(read_field gateway-sparse.json miles .lat)"
check "no tyres"      "null"    "$(read_field gateway-sparse.json miles .tyres)"

# A fake curl on PATH, so the paths that only exist when the gateway answers —
# headers, caching, and what happens when it does not answer — are testable
# without an account. These caught the bug where every gateway error reached
# the panel as "not signed in", because $GQL_ERROR was assigned inside a
# command substitution and could never escape it.
# An R1S has no tailgate and no tonneau, and Rivian answers for hardware the
# car does not have with "signal_not_available" rather than by omitting it.
# Read as "not "closed" means open", that reported both permanently open on
# every R1S ever sold.
# Rivian reports battery as a float; a real car answered 46.600002.
echo "float battery"
check "battery rounded" "47" \
  "$(jq -c '.data.vehicleState.batteryLevel={value:46.600002}' tests/fixtures/gateway-parked.json \
     | ./bin/rivian --units miles render | jq -c .battery)"
check "limit rounded" "80" \
  "$(jq -c '.data.vehicleState.batteryLimit={value:79.99999}' tests/fixtures/gateway-parked.json \
     | ./bin/rivian --units miles render | jq -c .charge_limit)"

echo "an R1S, which has no tailgate and no tonneau"
check "nothing open"    "[]"    "$(read_field gateway-r1s.json miles .open)"
check "no phantom OTA"  "null"  "$(read_field gateway-r1s.json miles .software_available)"
check "version still read" '"2026.23.0"' "$(read_field gateway-r1s.json miles .software)"
# A door that really is open still has to be reported.
check "real open door"  '["a door"]' \
  "$(jq -c '.data.vehicleState.doorRearLeftClosed={value:"open"}' tests/fixtures/gateway-r1s.json \
     | ./bin/rivian --units miles render | jq -c .open)"
# And an update that really is waiting still has to be offered.
check "real OTA offered" '"2026.34.00"' \
  "$(jq -c '.data.vehicleState.otaAvailableVersion={value:"2026.34.00"}' tests/fixtures/gateway-r1s.json \
     | ./bin/rivian --units miles render | jq -c .software_available)"

# Whoever drew the tiles has to be credited, and the credit has to follow the
# provider actually in use.
echo "tiles"
cred() { ./bin/rivian --tile-url "$1" map 37.7793 -122.4193 16 8 8 2>/dev/null | jq -c .attribution; }
check "esri credited" '"© Esri, HERE, Garmin, © OpenStreetMap contributors"' \
  "$(cred 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}')"
check "osm credited"  '"© OpenStreetMap contributors"' \
  "$(cred 'https://tile.openstreetmap.org/{z}/{x}/{y}.png')"
# CARTO now key-gates basemaps and signals it with an HTTP 200 nag PNG, so it
# must not be what a default install points at.
check "default is not carto" "no" \
  "$(grep -q 'cartocdn' <(grep '^TILE_URL=' ./bin/rivian) && echo yes || echo no)"
check "panel default not carto" "no" \
  "$(grep -q 'cartocdn.*return' Panel.qml && echo yes || echo no)"

echo "gateway"
SHIM=$(mktemp -d)
trap 'rm -rf "$SHIM"' EXIT
mkdir -p "$SHIM/bin"
export OMARCHY_RIVIAN_CONFIG_DIR="$SHIM/config" OMARCHY_RIVIAN_CACHE_DIR="$SHIM/cache"
mkdir -p "$SHIM/config"
echo '{"csrfToken":"CSRF123","appSessionToken":"APP456","userSessionToken":"USER789"}' \
  > "$SHIM/config/session.json"

shim() { # shim MODE
  cat > "$SHIM/bin/curl" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" >> "$SHIM/args.txt"
# The body arrives on stdin, not in argv — see the --data @- note in bin/rivian.
body=\$(cat)
case "$1" in
  ok)
    if [[ "\$body" == *getUserInfo* ]]; then
      printf '%s\n200' '{"data":{"currentUser":{"vehicles":[{"id":"veh-1","name":"Rivvy","vin":"VIN1","vehicle":{"model":"R1S","modelYear":2025}}]}}}'
    else printf '%s\n200' "\$(cat "$SHIM/state.json")"; fi ;;
  http500)  printf '%s\n500' '{}' ;;
  gqlerror) printf '%s\n200' '{"errors":[{"message":"UNAUTHENTICATED: session expired"}]}' ;;
esac
EOF
  chmod +x "$SHIM/bin/curl"
}
run() { PATH="$SHIM/bin:$PATH" ./bin/rivian --units miles "$@"; }

cp tests/fixtures/gateway-parked.json "$SHIM/state.json"
rm -f "$SHIM/args.txt"; shim ok
check "reading lands"   "179.6" "$(run car --force | jq -c .range)"
check "named from list" '"Rivvy"' "$(run car --force | jq -c .name)"
# All three session tokens must reach curl, or every call is anonymous.
sent() { grep -qx "$1" "$SHIM/args.txt" && echo yes || echo no; }
check "csrf header"   "yes" "$(sent 'Csrf-Token: CSRF123')"
check "a-sess header" "yes" "$(sent 'A-Sess: APP456')"
check "u-sess header" "yes" "$(sent 'U-Sess: USER789')"
check "client name"   "yes" "$(sent 'Apollographql-Client-Name: com.rivian.ios.consumer-apollo-ios')"
check "cached"       "false" "$(run car | jq -c .fresh)"
check "force skips cache" "true" "$(run car --force | jq -c .fresh)"

# A gateway that is down must not blank the panel: the last known position of
# a parked car does not stop being true because the network went away.
shim http500
check "http error kept"  '"gateway said 500"' "$(run car --force | jq -c .error)"
check "stale flagged"    "true"    "$(run car --force | jq -c .stale)"
check "position held"    "37.7749" "$(run car --force | jq -c .lat)"
check "still ok"         "true"    "$(run car --force | jq -c .ok)"

# GraphQL answers 200 and puts the failure in the body, so the status code
# alone proves nothing.
shim gqlerror
check "gql error kept" '"UNAUTHENTICATED: session expired"' "$(run car --force | jq -c .error)"

# With nothing cached there is nothing to fall back to, and the hint has to
# say what to do about it.
rm -rf "$SHIM/cache"
check "fails honestly" "false" "$(run car --force | jq -c .ok)"
check "hints at login" "true"  "$(run car --force | jq -r '.hint | test("login")')"

# Signing in, both legs, against a gateway that can be told to demand a code.
echo "login"
LSHIM=$(mktemp -d)
trap 'rm -rf "$SHIM" "$LSHIM"' EXIT
mkdir -p "$LSHIM/bin" "$LSHIM/config"
export OMARCHY_RIVIAN_CONFIG_DIR="$LSHIM/config" OMARCHY_RIVIAN_CACHE_DIR="$LSHIM/cache"
cat > "$LSHIM/bin/curl" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$LSHIM/argv.txt"
body=\$(cat)
printf '%s' "\$body" >> "$LSHIM/bodies.txt"
case "\$body" in
  *CreateCSRFToken*) printf '%s\n200' '{"data":{"createCsrfToken":{"csrfToken":"C1","appSessionToken":"A1"}}}' ;;
  *'"operationName":"Login"'*)
     if [ -f "$LSHIM/mfa" ]; then printf '%s\n200' '{"data":{"login":{"__typename":"MobileMFALoginResponse","otpToken":"OTP-TOK"}}}'
     else printf '%s\n200' '{"data":{"login":{"__typename":"MobileLoginResponse","accessToken":"AT","refreshToken":"RT","userSessionToken":"UT"}}}'; fi ;;
  *LoginWithOTP*)
     if [[ "\$body" == *'"otpCode":"999999"'* ]]; then printf '%s\n200' '{"errors":[{"message":"Invalid code"}]}'
     else printf '%s\n200' '{"data":{"loginWithOTP":{"__typename":"MobileLoginResponse","accessToken":"AT2","refreshToken":"RT2","userSessionToken":"UT2"}}}'; fi ;;
esac
EOF
chmod +x "$LSHIM/bin/curl"
login() { PATH="$LSHIM/bin:$PATH" ./bin/rivian "$@"; }

# An account with MFA off signs in on the first leg.
rm -f "$LSHIM/mfa" "$LSHIM/config/session.json"
check "no-mfa signs in" "true" "$(printf 'me@x.com\npw\n' | login login --stdin | jq -c .signedIn)"
check "token stored"    '"UT"' "$(jq -c .userSessionToken "$LSHIM/config/session.json")"

# An account with MFA on stops for a code, and says so rather than erroring.
rm -f "$LSHIM/config/session.json"; touch "$LSHIM/mfa"
check "mfa asks"        "true" "$(printf 'me@x.com\npw\n' | login login --stdin | jq -c .mfa)"
check "pending noted"   "true" "$(login pending | jq -c .pending)"
# The half-finished sign-in must not carry the password across the two legs.
check "pending has no password" "no" \
  "$(grep -q 'pw' "$LSHIM/config/pending-otp.json" && echo yes || echo no)"

# Rivian's own rejection reaches the caller intact.
check "bad code refused" "false" "$(printf '999999\n' | login otp --stdin | jq -c .ok)"
check "bad code message" '"Invalid code"' "$(printf '999999\n' | login otp --stdin | jq -c .error)"
check "still pending"    "true"  "$(login pending | jq -c .pending)"

check "good code works"  "true"  "$(printf '123456\n' | login otp --stdin | jq -c .signedIn)"
check "second token"     '"UT2"' "$(jq -c .userSessionToken "$LSHIM/config/session.json")"
check "pending cleared"  "false" "$(login pending | jq -c .pending)"

# Empty input must be refused rather than sent.
check "empty refused"    "false" "$(printf '\n\n' | login login --stdin | jq -c .ok)"

# The invariant that matters most: a password must never reach a command line,
# because /proc/<pid>/cmdline is world-readable and would publish it to every
# process on the machine for the life of the request.
rm -f "$LSHIM/config/session.json" "$LSHIM/bodies.txt"
printf 'me@x.com\nCANARYPW\n' | login login --stdin > /dev/null
check "password not in argv" "no" \
  "$(grep -q CANARYPW "$LSHIM/argv.txt" && echo yes || echo no)"
check "password sent in body" "yes" \
  "$(grep -q CANARYPW "$LSHIM/bodies.txt" && echo yes || echo no)"
check "password not on disk" "no" \
  "$(grep -rq CANARYPW "$LSHIM/config" 2>/dev/null && echo yes || echo no)"

# logout takes the half-finished sign-in with it.
touch "$LSHIM/mfa"; rm -f "$LSHIM/config/session.json"
printf 'me@x.com\npw\n' | login login --stdin > /dev/null
login logout 2>/dev/null
check "logout clears pending" "false" "$(login pending | jq -c .pending)"

unset OMARCHY_RIVIAN_CONFIG_DIR OMARCHY_RIVIAN_CACHE_DIR

echo "shell"
check "syntax" "ok" "$(bash -n $RIVIAN 2>/dev/null && echo ok)"

printf '\n%d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
